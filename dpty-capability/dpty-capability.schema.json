{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.byteowlz.dev/dpty-capability/dpty-capability.schema.json",
  "title": "dpty Machine Capability manifest",
  "version": "0.1.0",
  "stability": "draft",
  "description": "Machine capability auto-acquired by dpty install (ADR-0007). Backend-agnostic, cross-platform. Canonical home: byteowlz/dpty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine", "system", "devices", "engines", "assets", "declared", "observed"],
  "properties": {
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hostname", "os_arch", "platform", "mesh_ip", "acquired_at"],
      "properties": {
        "id": { "type": "string" },
        "hostname": { "type": "string" },
        "os_arch": { "type": "string", "examples": ["linux/amd64", "darwin/arm64", "windows/amd64"] },
        "platform": { "type": "string" },
        "mesh_ip": { "type": "string" },
        "acquired_at": { "type": "string", "format": "date-time" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ram_gb", "cpu"],
      "properties": {
        "ram_gb": { "type": "number", "minimum": 0 },
        "cpu": { "type": "string" }
      }
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "free_gb"],
        "properties": {
          "path": { "type": "string" },
          "free_gb": { "type": "number", "minimum": 0 },
          "total_gb": { "type": "number", "minimum": 0 }
        }
      }
    },
    "devices": {
      "description": "Normalized accelerator devices. ONE uniform representation across every backend: dedicated VRAM AND Apple unified memory both report mem_gb.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "name", "mem_gb", "arch"],
        "properties": {
          "backend": { "enum": ["cuda", "rocm", "level-zero", "metal-mps", "vulkan", "opencl", "directml"] },
          "name": { "type": "string" },
          "mem_gb": { "type": "number", "minimum": 0 },
          "arch": { "type": "string", "description": "Per-backend nomenclature, e.g. sm_120a / gfx90a / m3" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detected"],
        "properties": {
          "detected": { "type": "boolean" },
          "path": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "assets": {
      "description": "Dynamic asset cache: models + workflows already on the machine, with pinned rev. Merged into placement (static capability ∪ dynamic asset cache).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rev"],
            "properties": {
              "name": { "type": "string" },
              "rev": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rev"],
            "properties": {
              "name": { "type": "string", "description": "comfyui-workflows/<name>" },
              "rev": { "type": "string" }
            }
          }
        }
      }
    },
    "declared": {
      "description": "What Ansible/install intended (provisioning intent).",
      "type": "object",
      "additionalProperties": true
    },
    "observed": {
      "description": "What introspection finds at runtime. DRIFT = declared ≠ observed, surfaced before placement.",
      "type": "object",
      "additionalProperties": true
    }
  }
}
