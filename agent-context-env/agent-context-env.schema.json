{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.byteowlz.dev/agent-context-env/agent-context-env.schema.json",
  "title": "AGENT_CTX Environment Contract (v2)",
  "version": "2.0.0",
  "stability": "accepted",
  "description": "Normalized AGENT_CTX_* environment metadata represented as a JSON object. Flat set of optional bags produced by independent layers (platform, multiplexer, harness, host). Missing layers are simply absent; consumers must tolerate any combination.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "AGENT_CTX_VERSION": { "type": "string", "const": "2" },
    "AGENT_CTX_HARNESS": { "type": "string", "minLength": 1 },
    "AGENT_CTX_RUN_MODE": { "type": "string", "enum": ["local", "runner", "container"] },
    "AGENT_CTX_PLATFORM_NAME": { "type": "string", "minLength": 1 },
    "AGENT_CTX_PLATFORM_VERSION": { "type": "string", "minLength": 1 },
    "AGENT_CTX_PLATFORM_SESSION_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_WORKSPACE_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_WORKSPACE_PATH": { "type": "string", "minLength": 1 },
    "AGENT_CTX_USER_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_MULTIPLEXER": { "type": "string", "minLength": 1 },
    "AGENT_CTX_AGENT_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_AGENT_ADDRESS": { "type": "string", "minLength": 1 },
    "AGENT_CTX_AGENT_LABEL": { "type": "string", "minLength": 1 },
    "AGENT_CTX_HARNESS_SESSION_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_SESSION_NAME": { "type": "string", "minLength": 1 },
    "AGENT_CTX_READABLE_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_MODEL": { "type": "string", "minLength": 1 },
    "AGENT_CTX_REQUEST_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_CORRELATION_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_SANDBOX_PROFILE": { "type": "string", "minLength": 1 },
    "AGENT_CTX_MACHINE_ID": { "type": "string", "minLength": 1 },
    "AGENT_CTX_NODE_HOSTNAME": { "type": "string", "minLength": 1 },
    "AGENT_CTX_OS_ARCH": { "type": "string", "minLength": 1 }
  },
  "required": [
    "AGENT_CTX_VERSION",
    "AGENT_CTX_HARNESS",
    "AGENT_CTX_RUN_MODE"
  ],
  "allOf": [
    {
      "description": "At least one locator is required (platform session, harness session, or machine id).",
      "anyOf": [
        { "required": ["AGENT_CTX_PLATFORM_SESSION_ID"] },
        { "required": ["AGENT_CTX_HARNESS_SESSION_ID"] },
        { "required": ["AGENT_CTX_MACHINE_ID"] }
      ]
    },
    {
      "description": "Platform bag: when the platform is present, its companions are required.",
      "if": { "required": ["AGENT_CTX_PLATFORM_NAME"] },
      "then": {
        "required": [
          "AGENT_CTX_PLATFORM_VERSION",
          "AGENT_CTX_PLATFORM_SESSION_ID",
          "AGENT_CTX_WORKSPACE_ID",
          "AGENT_CTX_WORKSPACE_PATH",
          "AGENT_CTX_USER_ID"
        ]
      }
    },
    {
      "description": "Multiplexer bag: when a multiplexer is present, AGENT_ID is required (address/label optional).",
      "if": { "required": ["AGENT_CTX_MULTIPLEXER"] },
      "then": { "required": ["AGENT_CTX_AGENT_ID"] }
    }
  ]
}
