{
  "$id": "https://github.com/byteowlz/brwsr/schemas/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brwsr configuration",
  "description": "Configuration schema for brwsr",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for editor support",
      "type": "string"
    },
    "cdp": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:9222",
          "description": "Chrome DevTools HTTP endpoint."
        },
        "default_target": {
          "type": "string",
          "default": "current",
          "description": "Default target selector. Use current, active, a tab index, target id, URL substring, or title substring."
        }
      },
      "additionalProperties": false,
      "default": {
        "endpoint": "http://127.0.0.1:9222",
        "default_target": "current"
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "default": "./artifacts",
          "description": "Default artifact output directory. Supports ~ and environment variables."
        }
      },
      "additionalProperties": false,
      "default": {
        "dir": "./artifacts"
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "idle_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 750,
          "description": "Default network idle window in milliseconds."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 10000,
          "description": "Default wait timeout in milliseconds."
        }
      },
      "additionalProperties": false,
      "default": {
        "idle_ms": 750,
        "timeout_ms": 10000
      }
    }
  },
  "additionalProperties": false
}
